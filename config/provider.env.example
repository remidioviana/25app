# Example only. Provision actual credentials in protected server environment/secrets.
# The application does not automatically load this file or .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
AGENT_PLANNER_MODEL=openai/gpt-oss-20b
AGENT_SPECIALIST_MODEL=openai/gpt-oss-20b
AGENT_AUDITOR_MODEL=openai/gpt-oss-120b
# Defaults contain two IDs across three roles; no live verification is implied.
AGENT_REQUIRE_DISTINCT_MODELS=0
AGENT_ALLOW_PREVIEW_MODELS=0
# To evaluate three distinct models in isolation, use the documented manual
# three-model-evaluation workflow profile. Qwen3.8 is Preview, not Production.
